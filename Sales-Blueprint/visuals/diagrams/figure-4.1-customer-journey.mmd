%% Figure 4.1: The Customer Journey
%% Placement: manuscript/part-02-blueprint-framework/module-04-learn-the-customer.md
%% Caption: Figure 4.1: four stages of a buyer's own journey toward a decision, each needing different information from them.
flowchart TD
    subgraph Row1 [" "]
        direction LR
        A["Aware of the problem\nknows something needs to change"] --> B["Evaluating options\ncomparing suppliers, weighing risk"]
    end
    subgraph Row2 [" "]
        direction LR
        C["Deciding internally\nbuilding consensus with the committee"] --> D["Justifying the choice\ndefending it to their board or team"]
    end
    B --> C

    classDef stage fill:#E3EEEC,stroke:#0F3D3E,color:#0F3D3E;
    class A,B,C,D stage;
    style Row1 fill:transparent,stroke:transparent
    style Row2 fill:transparent,stroke:transparent
