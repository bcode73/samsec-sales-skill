%% Figure 0.1: The Blueprint Framework
%% Placement: manuscript/front-matter/07-the-blueprint-framework.md
%% Caption: Figure 0.1: The Blueprint Framework, the nine stages a buyer moves through on the way to a decision.
flowchart TD
    subgraph Row1 [" "]
        direction LR
        B["B\nBuild Trust"] --> L["L\nLearn the Customer"] --> U["U\nUnderstand the Problem"]
    end
    subgraph Row2 [" "]
        direction LR
        E["E\nEstablish Value"] --> P["P\nPresent the Offer"] --> R["R\nRemove Doubt"]
    end
    subgraph Row3 [" "]
        direction LR
        I["I\nInspire Action"] --> N["N\nNurture Relationships"] --> T["T\nTurn Customers into Advocates"]
    end
    B <-.-|new referral, cycle restarts| T
    U --> E
    R --> I

    classDef stage fill:#0F3D3E,stroke:#0F3D3E,color:#FFFFFF;
    class B,L,U,E,P,R,I,N,T stage;
    style Row1 fill:transparent,stroke:transparent
    style Row2 fill:transparent,stroke:transparent
    style Row3 fill:transparent,stroke:transparent
